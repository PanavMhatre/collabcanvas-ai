# Copy this file to .env.local (which is gitignored) to customize.

# Where the browser connects for realtime sync. Must match the sync server's PORT.
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# Optional. Without this, the AI copilot falls back to deterministic
# templates (netflix / uber / url-shortener / generic microservices) so the
# demo still works with zero configuration.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
